{
  "id": "exercise4_leave_form",
  "type": "default",
  "components": [
    {
      "id": "Text_Heading",
      "type": "text",
      "text": "# Leave request\nEnter your name, leave date and reason. All three fields are required."
    },
    {
      "id": "Field_Name",
      "type": "textfield",
      "label": "Name",
      "key": "name",
      "validate": { "required": true },
      "layout": { "row": "Row_Name" }
    },
    {
      "id": "Field_Date",
      "type": "datetime",
      "subtype": "date",
      "dateLabel": "Date",
      "key": "date",
      "validate": { "required": true },
      "layout": { "row": "Row_Date" }
    },
    {
      "id": "Field_Reason",
      "type": "textarea",
      "label": "Reason",
      "key": "reason",
      "validate": { "required": true },
      "layout": { "row": "Row_Reason" }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8",
  "schemaVersion": 16
}
